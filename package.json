{
  "type": "module",
  "name": "vanbotjs",
  "version": "1.0.0",
  "description": "多平台机器人框架：适配器可插拔、能力驱动、内核统一收发降级",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "van": "./bin/van.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "van run",
    "test": "tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nut-tree/nut-js": "^3.1.2",
    "better-sqlite3": "^13.0.3",
    "file-box": "^1.5.5",
    "fzstd": "^0.1.1",
    "koffi": "^3.3.1",
    "node-schedule": "^2.1.1",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.7",
    "wechatferry": "^0.0.26",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "icqq": "^0.6.10",
    "mineflayer": "^4.38.0",
    "mineflayer-pathfinder": "^2.4.5",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vec3": "^0.2.0",
    "vitepress": "^1.6.4"
  }
}
