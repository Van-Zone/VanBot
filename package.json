{
  "type": "module",
  "name": "vanbotjs",
  "version": "1.0.0",
  "description": "多平台机器人框架：适配器可插拔、能力驱动、内核统一收发降级",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "van": "./bin/van.mjs"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "van run",
    "test": "tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-schedule": "^2.1.1",
    "playwright-core": "^1.63.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.7",
    "typescript": "^5.9.3"
  }
}
